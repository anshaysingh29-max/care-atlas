# CareAtlas Firebase Web App configuration
# Firebase Console -> Project settings -> General -> Your apps -> Web app
# These NEXT_PUBLIC values identify the Firebase project used by the browser.
# Do not put service-account JSON/private keys in this file or in browser code.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. We are not using Analytics in Phase 6A.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Phase 6C Google Apps Script document gateway. The /exec URL is public; authentication is enforced with Firebase ID tokens.
NEXT_PUBLIC_DRIVE_GATEWAY_URL=

# Phase 6F optional Firebase App Check. Configure a reCAPTCHA v3 provider in
# Firebase Console -> App Check before setting this value. Leave blank until ready.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Local development only. Never set true in .env.production.
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG=false
