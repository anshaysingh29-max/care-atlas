rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isCareAtlasStaff() {
      return hasUserProfile() && currentUser().data.role in [
        'careatlas_coordinator',
        'careatlas_operations',
        'careatlas_admin',
        'super_admin'
      ];
    }

    function isAdmin() {
      return hasUserProfile() && currentUser().data.role in [
        'careatlas_admin',
        'super_admin'
      ];
    }

    function hasReferralPartnerProfile() {
      return hasUserProfile()
        && currentUser().data.role in ['partner', 'patient']
        && currentUser().data.status != 'disabled'
        && exists(/databases/$(database)/documents/partners/$(request.auth.uid))
        && !(get(/databases/$(database)/documents/partners/$(request.auth.uid)).data.status in ['rejected', 'suspended']);
    }

    function isReferralPartner() {
      return hasReferralPartnerProfile()
        && get(/databases/$(database)/documents/partners/$(request.auth.uid)).data.status == 'approved';
    }

    function partnerKycVerified(partnerId) {
      return exists(/databases/$(database)/documents/partnerKyc/$(partnerId))
        && get(/databases/$(database)/documents/partnerKyc/$(partnerId)).data.status == 'verified';
    }

    function partnerPayoutVerified(partnerId) {
      return exists(/databases/$(database)/documents/partnerPayoutProfiles/$(partnerId))
        && get(/databases/$(database)/documents/partnerPayoutProfiles/$(partnerId)).data.status == 'verified';
    }


    function isHotelPartner() {
      return hasUserProfile()
        && currentUser().data.role == 'hotel_partner'
        && currentUser().data.status != 'disabled'
        && exists(/databases/$(database)/documents/hotels/$(request.auth.uid))
        && !(get(/databases/$(database)/documents/hotels/$(request.auth.uid)).data.status in ['rejected', 'suspended']);
    }

    function hotelPartnerApproved() {
      return isHotelPartner()
        && get(/databases/$(database)/documents/hotels/$(request.auth.uid)).data.status == 'approved';
    }

    function stayHotelApproved(stayHotelId) {
      return exists(/databases/$(database)/documents/hotels/$(stayHotelId))
        && get(/databases/$(database)/documents/hotels/$(stayHotelId)).data.status == 'approved';
    }

    function isHospitalApplicant() {
      return hasUserProfile()
        && currentUser().data.role == 'hospital_applicant'
        && currentUser().data.status != 'disabled';
    }

    function isHospitalUser() {
      return hasUserProfile() && currentUser().data.role in [
        'hospital_admin',
        'hospital_doctor',
        'hospital_coordinator'
      ];
    }

    function isHospitalClinicalUser() {
      return hasUserProfile() && currentUser().data.role in [
        'hospital_admin',
        'hospital_doctor'
      ];
    }

    function hospitalId() {
      return currentUser().data.hospitalId;
    }

    function ownsCase(caseData) {
      return signedIn() && caseData.patientId == request.auth.uid;
    }

    function hospitalCanAccessCase(caseData) {
      return isHospitalUser()
        && hospitalId() in caseData.get('assignedHospitalIds', []);
    }

    function consentState(caseId) {
      return get(/databases/$(database)/documents/caseConsentStates/$(caseId));
    }

    function hasConsentState(caseId) {
      return exists(/databases/$(database)/documents/caseConsentStates/$(caseId));
    }

    function medicalDataConsentGranted(caseId) {
      return hasConsentState(caseId)
        && consentState(caseId).data.medicalDataProcessing == true;
    }

    function hospitalDocumentConsentGranted(caseId) {
      return hasConsentState(caseId)
        && consentState(caseId).data.medicalDataProcessing == true
        && consentState(caseId).data.hospitalSharing == true;
    }

    function messagingConsentGranted(caseId) {
      return hasConsentState(caseId)
        && consentState(caseId).data.careCoordinationMessaging == true;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.role in ['patient', 'partner', 'hotel_partner', 'hospital_applicant']
        && (
          (request.resource.data.role != 'hotel_partner' || request.resource.data.hotelId == request.auth.uid) &&
          (request.resource.data.role != 'hospital_applicant' || request.resource.data.hospitalApplicationId == request.auth.uid)
        );

      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isCareAtlasStaff()
      );

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'country', 'updatedAt'
        ]);

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'patient'
        && request.auth.uid == patientId
        && request.resource.data.userId == request.auth.uid;

      allow read: if signedIn() && (
        request.auth.uid == patientId ||
        isCareAtlasStaff()
      );

      allow update: if signedIn()
        && request.auth.uid == patientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'country', 'age', 'gender', 'phone',
          'preferredLanguage', 'updatedAt'
        ]);

      allow update: if isCareAtlasStaff();
      allow delete: if false;
    }

    match /careNavigatorProfiles/{patientId} {
      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.auth.uid == patientId
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.source == 'patient_web'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        request.auth.uid == patientId ||
        isCareAtlasStaff()
      );

      allow update: if signedIn()
        && currentUser().data.role == 'patient'
        && request.auth.uid == patientId
        && resource.data.patientId == request.auth.uid
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.source == 'patient_web'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'algorithmVersion', 'specialtyId', 'treatmentSlug', 'destinationIds',
          'preferredLanguages', 'priorityIds', 'budgetBandId',
          'shortlistedHospitalIds', 'matchSummaries', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /careMatchRuns/{matchRunId} {
      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.resource.data.matchRunId == matchRunId
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.source == 'patient_web'
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff()
      );

      allow update, delete: if false;
    }

    match /cases/{caseId} {
      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.currentStage == 'case_submitted'
        && request.resource.data.assignedHospitalIds.size() == 0
        && request.resource.data.coordinatorId == null
        && request.resource.data.documentCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.submittedAt == request.time;

      allow read: if signedIn() && (
        ownsCase(resource.data) ||
        isCareAtlasStaff() ||
        hospitalCanAccessCase(resource.data)
      );

      allow update: if signedIn()
        && ownsCase(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'documentCount', 'updatedAt'
        ])
        && request.resource.data.documentCount is int
        && request.resource.data.documentCount >= 0
        && request.resource.data.updatedAt == request.time;

      allow update: if isCareAtlasStaff();
      allow delete: if isAdmin();
    }

    match /caseConsentStates/{caseId} {
      function requestedCase() {
        return get(/databases/$(database)/documents/cases/$(caseId));
      }

      allow create: if signedIn()
        && request.resource.data.caseId == caseId
        && request.resource.data.patientId == request.auth.uid
        && requestedCase().data.patientId == request.auth.uid
        && request.resource.data.version == '2026-08-24-v1'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.medicalDataProcessing is bool
        && request.resource.data.hospitalSharing is bool
        && request.resource.data.careCoordinationMessaging is bool;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff() ||
        hospitalCanAccessCase(requestedCase().data)
      );

      allow update: if signedIn()
        && resource.data.patientId == request.auth.uid
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.caseId == resource.data.caseId
        && requestedCase().data.patientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'version', 'medicalDataProcessing', 'hospitalSharing',
          'careCoordinationMessaging', 'updatedAt'
        ])
        && request.resource.data.version == '2026-08-24-v1'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.medicalDataProcessing is bool
        && request.resource.data.hospitalSharing is bool
        && request.resource.data.careCoordinationMessaging is bool;

      allow delete: if false;
    }

    match /consents/{consentId} {
      function requestedConsentCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      function linkedConsentCase() {
        return get(/databases/$(database)/documents/cases/$(resource.data.caseId));
      }

      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && requestedConsentCase().data.patientId == request.auth.uid
        && request.resource.data.consentType in [
          'medical_data_processing',
          'hospital_sharing',
          'care_coordination_messaging'
        ]
        && request.resource.data.decision in ['accepted', 'declined', 'withdrawn']
        && request.resource.data.version == '2026-08-24-v1'
        && request.resource.data.consentText is string
        && request.resource.data.source == 'patient_web'
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff() ||
        hospitalCanAccessCase(linkedConsentCase().data)
      );

      allow update, delete: if false;
    }

    match /caseDocuments/{documentId} {
      function linkedCase() {
        return get(/databases/$(database)/documents/cases/$(resource.data.caseId));
      }

      function requestedCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.storageProvider == 'google_drive'
        && requestedCase().data.patientId == request.auth.uid
        && medicalDataConsentGranted(request.resource.data.caseId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        (isCareAtlasStaff() && medicalDataConsentGranted(resource.data.caseId)) ||
        (
          hospitalCanAccessCase(linkedCase().data) &&
          hospitalDocumentConsentGranted(resource.data.caseId)
        )
      );

      allow update: if false;
      allow delete: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isAdmin()
      );
    }


    match /partners/{partnerId} {
      allow create: if signedIn()
        && request.auth.uid == partnerId
        && (
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'partner' ||
          (
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'patient' &&
            exists(/databases/$(database)/documents/patients/$(request.auth.uid))
          )
        )
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.commissionModel == 'revenue_share'
        && request.resource.data.commissionRatePct == 0
        && request.resource.data.termsAccepted == true
        && request.resource.data.disclosureAccepted == true
        && request.resource.data.termsVersion == '2026-08-25-v1'
        && request.resource.data.referralCode is string
        && request.resource.data.referralCode.size() >= 8
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        request.auth.uid == partnerId ||
        isAdmin()
      );

      allow update: if signedIn()
        && request.auth.uid == partnerId
        && resource.data.status in ['pending_review', 'approved']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'country', 'phone', 'organization', 'partnerType', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if isAdmin();
    }

    match /partnerKyc/{partnerId} {
      allow create: if hasReferralPartnerProfile()
        && request.auth.uid == partnerId
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.entityType in ['individual', 'business']
        && request.resource.data.legalName is string
        && request.resource.data.legalName.size() > 0
        && request.resource.data.country is string
        && request.resource.data.taxIdType is string
        && request.resource.data.taxId is string
        && request.resource.data.taxId.size() >= 4
        && request.resource.data.status == 'submitted'
        && request.resource.data.kycVersion == '2026-08-25-v1'
        && request.resource.data.createdAt == request.time
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        request.auth.uid == partnerId ||
        isAdmin()
      );

      allow update: if hasReferralPartnerProfile()
        && request.auth.uid == partnerId
        && resource.data.status != 'verified'
        && request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.status == 'submitted'
        && request.resource.data.reviewNote == ''
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'entityType','legalName','country','taxIdType','taxId','taxIdMasked',
          'addressLine1','addressLine2','city','region','postalCode','status',
          'kycVersion','reviewNote','reviewedBy','reviewedAt','submittedAt','updatedAt'
        ]);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reviewNote','reviewedBy','reviewedAt','updatedAt'
        ])
        && request.resource.data.status in ['submitted','needs_correction','verified','rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /partnerPayoutProfiles/{partnerId} {
      allow create: if hasReferralPartnerProfile()
        && request.auth.uid == partnerId
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.method in ['bank','upi']
        && request.resource.data.accountHolder is string
        && request.resource.data.accountHolder.size() > 0
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        request.auth.uid == partnerId ||
        isAdmin()
      );

      allow update: if hasReferralPartnerProfile()
        && request.auth.uid == partnerId
        && resource.data.status != 'verified'
        && request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.status == 'submitted'
        && request.resource.data.reviewNote == ''
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'method','payoutCurrency','payoutCountry','accountHolder','bankName',
          'accountNumber','accountNumberMasked','routingCode','swiftCode','upiId',
          'status','reviewNote','reviewedBy','reviewedAt','submittedAt','updatedAt'
        ]);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reviewNote','reviewedBy','reviewedAt','updatedAt'
        ])
        && request.resource.data.status in ['submitted','needs_correction','verified','rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /systemSettings/{settingId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /partnerPayoutRequests/{partnerId} {
      allow create: if isReferralPartner()
        && request.auth.uid == partnerId
        && request.resource.data.requestId == partnerId
        && request.resource.data.partnerId == partnerId
        && partnerKycVerified(partnerId)
        && partnerPayoutVerified(partnerId)
        && request.resource.data.status == 'requested'
        && request.resource.data.grossAmountSnapshot is number
        && request.resource.data.grossAmountSnapshot > 0
        && request.resource.data.taxWithheldSnapshot == 0
        && request.resource.data.netAmountSnapshot == request.resource.data.grossAmountSnapshot
        && request.resource.data.commissionIds is list
        && request.resource.data.commissionIds.size() > 0
        && request.resource.data.requestedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        request.auth.uid == partnerId ||
        isAdmin()
      );

      allow update: if isReferralPartner()
        && request.auth.uid == partnerId
        && resource.data.status in ['paid','rejected']
        && request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.requestId == resource.data.requestId
        && partnerKycVerified(partnerId)
        && partnerPayoutVerified(partnerId)
        && request.resource.data.status == 'requested'
        && request.resource.data.taxWithheldSnapshot == 0
        && request.resource.data.netAmountSnapshot == request.resource.data.grossAmountSnapshot
        && request.resource.data.commissionIds is list
        && request.resource.data.commissionIds.size() > 0
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'partnerName','grossAmountSnapshot','taxWithheldSnapshot','netAmountSnapshot',
          'currency','commissionIds','commissionCount','payoutMethod',
          'payoutDestinationSnapshot','status','paymentReference','settlementNote',
          'requestedAt','updatedAt','paidAt'
        ]);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','taxWithheldSnapshot','netAmountSnapshot','paymentReference',
          'settlementNote','paidAt','updatedAt'
        ])
        && request.resource.data.status in ['on_hold','paid','rejected']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /payoutSettlements/{settlementId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (hasReferralPartnerProfile() && resource.data.partnerId == request.auth.uid)
      );

      allow create: if isAdmin()
        && request.resource.data.settlementId == settlementId
        && request.resource.data.paidBy == request.auth.uid
        && request.resource.data.partnerId is string
        && request.resource.data.grossAmount is number
        && request.resource.data.taxWithheld is number
        && request.resource.data.netAmount is number
        && request.resource.data.netAmount >= 0
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() > 0
        && request.resource.data.paidAt == request.time
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /referralCodes/{code} {
      // Public callers may validate a code by exact document ID, but cannot enumerate codes.
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /partnerLeads/{leadId} {
      allow create: if isReferralPartner()
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 80
        && request.resource.data.treatmentInterest is string
        && request.resource.data.treatmentInterest.size() <= 120
        && request.resource.data.contactMethod in ['phone', 'whatsapp', 'email']
        && request.resource.data.contactValue is string
        && request.resource.data.contactValue.size() > 0
        && request.resource.data.contactValue.size() <= 160
        && request.resource.data.contactConsent == true
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.campaign is string
        && request.resource.data.campaign.size() <= 48
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'partner_web'
        && request.resource.data.convertedCaseId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        isCareAtlasStaff() ||
        (hasReferralPartnerProfile() && resource.data.partnerId == request.auth.uid)
      );

      allow update: if isCareAtlasStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'convertedCaseId', 'updatedAt'
        ])
        && request.resource.data.status in ['new', 'contacted', 'qualified', 'converted', 'closed']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }


    match /referrals/{referralId} {
      function requestedReferralCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      function requestedReferralCode() {
        return get(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCode));
      }

      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.resource.data.referralId == referralId
        && request.resource.data.caseId == referralId
        && requestedReferralCase().data.patientId == request.auth.uid
        && requestedReferralCode().data.status == 'active'
        && request.resource.data.partnerId == requestedReferralCode().data.partnerId
        && request.resource.data.caseNumber == requestedReferralCase().data.caseNumber
        && request.resource.data.patientCountry == requestedReferralCase().data.patientCountry
        && request.resource.data.treatmentName == requestedReferralCase().data.treatmentName
        && request.resource.data.currentStage == requestedReferralCase().data.currentStage
        && request.resource.data.caseStatus == requestedReferralCase().data.status
        && request.resource.data.referralStatus == 'case_created'
        && request.resource.data.commissionStatus == 'not_created'
        && request.resource.data.attributionModel == 'first_valid_referrer'
        && request.resource.data.attributionWindowDays == 60
        && request.resource.data.campaign is string
        && request.resource.data.campaign.size() <= 48
        && request.resource.data.selfReferral is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        isCareAtlasStaff() ||
        (hasReferralPartnerProfile() && resource.data.partnerId == request.auth.uid)
      );

      allow update: if isCareAtlasStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentStage', 'caseStatus', 'referralStatus', 'lockedAt', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'commissionStatus', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      // Attribution ownership is immutable in 7A. Any future override should use a dedicated audited server workflow.
      allow delete: if false;
    }

    match /commissions/{commissionId} {
      function requestedCommissionReferral() {
        return get(/databases/$(database)/documents/referrals/$(request.resource.data.referralId));
      }

      allow read: if signedIn() && (
        isAdmin() ||
        (hasReferralPartnerProfile() && resource.data.partnerId == request.auth.uid)
      );

      allow create: if isAdmin()
        && request.resource.data.commissionId == commissionId
        && request.resource.data.referralId == commissionId
        && request.resource.data.partnerId == requestedCommissionReferral().data.partnerId
        && requestedCommissionReferral().data.referralStatus == 'treatment_verified'
        && requestedCommissionReferral().data.get('selfReferral', false) == false
        && request.resource.data.status == 'pending'
        && request.resource.data.commissionModel == 'revenue_share'
        && request.resource.data.ratePct is number
        && request.resource.data.ratePct >= 0
        && request.resource.data.ratePct <= 100
        && request.resource.data.careAtlasRevenue is number
        && request.resource.data.careAtlasRevenue >= 0
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'approvedAt', 'paidAt', 'payoutRequestId', 'paymentReference'
        ])
        && request.resource.data.status in ['approved', 'on_hold', 'paid', 'rejected']
        && (request.resource.data.status != 'approved' || partnerKycVerified(resource.data.partnerId))
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }



    match /travelProfiles/{caseId} {
      function requestedTravelProfileCase() {
        return get(/databases/$(database)/documents/cases/$(caseId));
      }

      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.resource.data.caseId == caseId
        && request.resource.data.patientId == request.auth.uid
        && requestedTravelProfileCase().data.patientId == request.auth.uid
        && request.resource.data.caseNumber == requestedTravelProfileCase().data.caseNumber
        && request.resource.data.homeCity is string
        && request.resource.data.destinationCountry is string
        && request.resource.data.passportReady is bool
        && request.resource.data.companionCount is int
        && request.resource.data.companionCount >= 0
        && request.resource.data.companionCount <= 10
        && request.resource.data.mobilitySupport is bool
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 700
        && request.resource.data.source == 'patient_web'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff()
      );

      allow update: if signedIn()
        && resource.data.patientId == request.auth.uid
        && requestedTravelProfileCase().data.patientId == request.auth.uid
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.caseId == resource.data.caseId
        && request.resource.data.caseNumber == resource.data.caseNumber
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'homeCity', 'destinationCountry', 'passportReady', 'companionCount',
          'mobilitySupport', 'notes', 'updatedAt'
        ])
        && request.resource.data.passportReady is bool
        && request.resource.data.companionCount is int
        && request.resource.data.companionCount >= 0
        && request.resource.data.companionCount <= 10
        && request.resource.data.mobilitySupport is bool
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 700
        && request.resource.data.updatedAt == request.time;

      allow update: if isCareAtlasStaff();
      allow delete: if isAdmin();
    }

    match /travelRequests/{requestId} {
      function requestedTravelCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.resource.data.requestId == requestId
        && request.resource.data.patientId == request.auth.uid
        && requestedTravelCase().data.patientId == request.auth.uid
        && request.resource.data.caseNumber == requestedTravelCase().data.caseNumber
        && request.resource.data.requestType in [
          'visa_assistance', 'flight_assistance', 'airport_pickup', 'local_transport'
        ]
        && request.resource.data.status == 'requested'
        && request.resource.data.providerName == ''
        && request.resource.data.confirmationReference == ''
        && request.resource.data.estimatedAmount == null
        && request.resource.data.adminNote == ''
        && request.resource.data.passengers is int
        && request.resource.data.passengers >= 1
        && request.resource.data.passengers <= 12
        && request.resource.data.mobilitySupport is bool
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 600
        && request.resource.data.source == 'patient_web'
        && request.resource.data.cancelledAt == null
        && request.resource.data.arrangedAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.requestedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff()
      );

      allow update: if signedIn()
        && resource.data.patientId == request.auth.uid
        && resource.data.status in ['requested', 'in_review', 'documents_needed']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'updatedAt'
        ])
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isCareAtlasStaff()
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.caseId == resource.data.caseId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'providerName', 'confirmationReference', 'estimatedAmount',
          'currency', 'adminNote', 'destinationCountry', 'originCity', 'destinationCity',
          'travelDate', 'travelTime', 'arrivalAirport', 'arrivalDate', 'arrivalTime',
          'airline', 'flightNumber', 'updatedAt', 'arrangedAt', 'completedAt'
        ])
        && request.resource.data.status in [
          'requested', 'in_review', 'documents_needed', 'arranged',
          'confirmed', 'completed', 'declined', 'cancelled'
        ]
        && request.resource.data.providerName is string
        && request.resource.data.confirmationReference is string
        && (request.resource.data.estimatedAmount == null || request.resource.data.estimatedAmount is number)
        && request.resource.data.adminNote is string
        && request.resource.data.adminNote.size() <= 800
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /travelItineraryEvents/{eventId} {
      function requestedItineraryCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      allow create: if isCareAtlasStaff()
        && request.resource.data.eventId == eventId
        && request.resource.data.patientId == requestedItineraryCase().data.patientId
        && request.resource.data.caseNumber == requestedItineraryCase().data.caseNumber
        && request.resource.data.eventType in [
          'flight', 'airport_pickup', 'hotel_checkin', 'hotel_checkout',
          'hospital_visit', 'consultation', 'treatment', 'local_transport', 'custom'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.eventDate is string
        && request.resource.data.eventDate.size() > 0
        && request.resource.data.eventTime is string
        && request.resource.data.location is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 800
        && request.resource.data.status in ['planned', 'confirmed', 'completed', 'cancelled']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByRole == currentUser().data.role
        && request.resource.data.source == 'admin_web'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff()
      );

      allow update: if isCareAtlasStaff()
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.caseId == resource.data.caseId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'eventType', 'title', 'eventDate', 'eventTime', 'location', 'note', 'status', 'updatedAt'
        ])
        && request.resource.data.eventType in [
          'flight', 'airport_pickup', 'hotel_checkin', 'hotel_checkout',
          'hospital_visit', 'consultation', 'treatment', 'local_transport', 'custom'
        ]
        && request.resource.data.status in ['planned', 'confirmed', 'completed', 'cancelled']
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /hotels/{hotelId} {
      allow get: if (
        (signedIn() && request.auth.uid == hotelId) ||
        isCareAtlasStaff() ||
        resource.data.status == 'approved'
      );

      allow list: if isCareAtlasStaff() || resource.data.status == 'approved';

      allow create: if signedIn()
        && request.auth.uid == hotelId
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'hotel_partner'
        && request.resource.data.hotelId == hotelId
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.commissionModel == 'booking_revenue_share'
        && request.resource.data.commissionRatePct == 0
        && request.resource.data.termsAccepted == true
        && request.resource.data.termsVersion == '2026-08-25-v1'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isHotelPartner()
        && request.auth.uid == hotelId
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'propertyName', 'propertyType', 'country', 'city',
          'addressLine1', 'addressLine2', 'postalCode',
          'contactName', 'contactPhone', 'website', 'description',
          'totalRooms', 'starRating', 'amenities', 'medicalStayFeatures',
          'mealOptions', 'photoUrls', 'nearbyHospitalIdsRequested', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if isAdmin();
      allow delete: if false;
    }

    match /hotelRooms/{roomId} {
      allow read: if (
        isCareAtlasStaff() ||
        (isHotelPartner() && resource.data.hotelId == request.auth.uid) ||
        stayHotelApproved(resource.data.hotelId)
      );

      allow create: if hotelPartnerApproved()
        && request.resource.data.roomId == roomId
        && request.resource.data.hotelId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.nightlyRate is number
        && request.resource.data.nightlyRate > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if hotelPartnerApproved()
        && resource.data.hotelId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'roomType', 'bedType', 'maxGuests', 'roomsAvailable',
          'nightlyRate', 'currency', 'taxesIncluded', 'features', 'active', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if isAdmin();
      allow delete: if false;
    }

    match /hotelAvailability/{availabilityId} {
      allow read: if (
        isCareAtlasStaff() ||
        (isHotelPartner() && resource.data.hotelId == request.auth.uid) ||
        stayHotelApproved(resource.data.hotelId)
      );

      allow create: if hotelPartnerApproved()
        && request.resource.data.availabilityId == availabilityId
        && request.resource.data.hotelId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/hotelRooms/$(request.resource.data.roomId)).data.hotelId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if hotelPartnerApproved()
        && resource.data.hotelId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'roomId', 'startDate', 'endDate', 'availableRooms',
          'nightlyRateOverride', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if isAdmin();
      allow delete: if false;
    }

    match /hotelBookings/{bookingId} {
      function requestedStayCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      function requestedStayHotel() {
        return get(/databases/$(database)/documents/hotels/$(request.resource.data.hotelId));
      }

      function requestedStayRoom() {
        return get(/databases/$(database)/documents/hotelRooms/$(request.resource.data.roomId));
      }

      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.resource.data.bookingId == bookingId
        && request.resource.data.patientId == request.auth.uid
        && requestedStayCase().data.patientId == request.auth.uid
        && requestedStayHotel().data.status == 'approved'
        && requestedStayRoom().data.hotelId == request.resource.data.hotelId
        && requestedStayRoom().data.active == true
        && request.resource.data.status == 'requested'
        && request.resource.data.settlementStatus == 'not_applicable'
        && request.resource.data.source == 'patient_web'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff() ||
        (isHotelPartner() && resource.data.hotelId == request.auth.uid)
      );

      allow update: if signedIn()
        && resource.data.patientId == request.auth.uid
        && resource.data.status in ['requested', 'quoted']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'updatedAt'
        ])
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if hotelPartnerApproved()
        && resource.data.hotelId == request.auth.uid
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.caseId == resource.data.caseId
        && request.resource.data.hotelId == resource.data.hotelId
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'quotedNightlyRate', 'taxesAndFees', 'totalAmount',
          'careAtlasCommissionRatePct', 'careAtlasCommissionAmount',
          'hotelNote', 'updatedAt', 'quotedAt', 'confirmedAt',
          'checkedInAt', 'completedAt', 'closedAt', 'settlementStatus'
        ])
        && request.resource.data.status in [
          'quoted', 'confirmed', 'checked_in', 'completed', 'declined', 'cancelled'
        ]
        && request.resource.data.settlementStatus in ['not_applicable', 'pending']
        && request.resource.data.updatedAt == request.time;

      allow update: if isCareAtlasStaff();
      allow delete: if isAdmin();
    }



    match /hospitalApplications/{applicationId} {
      allow create: if signedIn()
        && request.auth.uid == applicationId
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'hospital_applicant'
        && request.resource.data.applicationId == applicationId
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.termsAccepted == true
        && request.resource.data.termsVersion == '2026-08-25-v1'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.submittedAt == request.time;

      allow read: if signedIn() && (
        resource.data.ownerUserId == request.auth.uid ||
        isCareAtlasStaff()
      );

      allow update: if signedIn()
        && resource.data.ownerUserId == request.auth.uid
        && resource.data.status in ['pending_review', 'needs_correction']
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.applicationId == resource.data.applicationId
        && request.resource.data.status == 'pending_review'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hospitalName', 'legalName', 'country', 'city', 'address',
          'contactName', 'contactPhone', 'website', 'description',
          'internationalDeskEmail', 'internationalDeskPhone', 'languages',
          'services', 'accreditationClaims', 'specialtyIds',
          'requestedSpecialtyNames', 'status', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.submittedAt == request.time;

      allow update, delete: if isAdmin();
    }

    match /specialties/{specialtyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /hospitalCommercials/{hospitalId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /caseFinancials/{caseId} {
      // Canonical CareAtlas case economics. Never exposed to patients, providers or affiliates.
      allow read, create, update, delete: if isAdmin();
    }

    match /hospitalTeamInvites/{inviteId} {
      allow create: if signedIn()
        && currentUser().data.role == 'hospital_admin'
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.hospitalId == currentUser().data.hospitalId
        && request.resource.data.requestedRole in ['hospital_doctor', 'hospital_coordinator']
        && request.resource.data.status == 'pending_admin_provisioning'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        isCareAtlasStaff() ||
        (isHospitalUser() && resource.data.hospitalId == hospitalId())
      );

      allow update: if isAdmin();

      allow delete: if signedIn()
        && currentUser().data.role == 'hospital_admin'
        && resource.data.hospitalId == hospitalId()
        && resource.data.status == 'pending_admin_provisioning';
    }

    match /hospitals/{hospitalDocId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      allow update: if signedIn()
        && currentUser().data.role == 'hospital_admin'
        && currentUser().data.hospitalId == hospitalDocId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'website', 'address', 'description', 'internationalDeskEmail',
          'internationalDeskPhone', 'languages', 'services', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /treatments/{treatmentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /destinations/{destinationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /treatmentPlans/{planId} {
      function requestedPlanCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      allow read: if signedIn() && (
        isCareAtlasStaff() ||
        resource.data.patientId == request.auth.uid ||
        (isHospitalUser() && resource.data.hospitalId == hospitalId())
      );

      allow create: if isHospitalClinicalUser()
        && request.resource.data.hospitalId == hospitalId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.patientId == requestedPlanCase().data.patientId
        && hospitalCanAccessCase(requestedPlanCase().data)
        && request.resource.data.status == 'submitted'
        && request.resource.data.source == 'hospital_web';

      allow create: if isCareAtlasStaff();

      allow update: if isCareAtlasStaff() || (
        isHospitalClinicalUser()
        && resource.data.hospitalId == hospitalId()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'caseId','caseNumber','patientId','hospitalId','createdBy','createdAt','source'
        ])
      );

      allow delete: if isAdmin();
    }

    match /consultations/{consultationId} {
      function requestedConsultationCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      allow read: if signedIn() && (
        isCareAtlasStaff() ||
        resource.data.patientId == request.auth.uid ||
        (isHospitalUser() && resource.data.hospitalId == hospitalId())
      );

      allow create: if isHospitalUser()
        && request.resource.data.hospitalId == hospitalId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.patientId == requestedConsultationCase().data.patientId
        && hospitalCanAccessCase(requestedConsultationCase().data)
        && request.resource.data.status == 'proposed'
        && request.resource.data.source == 'hospital_web';

      allow create: if isCareAtlasStaff();

      allow update: if isCareAtlasStaff() || (
        isHospitalUser()
        && resource.data.hospitalId == hospitalId()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'caseId','caseNumber','patientId','hospitalId','createdBy','createdAt','source'
        ])
      );

      allow delete: if isAdmin();
    }

    match /caseMessages/{messageId} {
      function requestedMessageCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      function linkedMessageCase() {
        return get(/databases/$(database)/documents/cases/$(resource.data.caseId));
      }

      function validMessageBody() {
        return request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000;
      }

      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == 'patient'
        && request.resource.data.patientId == request.auth.uid
        && requestedMessageCase().data.patientId == request.auth.uid
        && messagingConsentGranted(request.resource.data.caseId)
        && validMessageBody()
        && request.resource.data.source == 'patient_web'
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.threadType == 'careatlas' &&
            request.resource.data.hospitalId == null
          ) ||
          (
            request.resource.data.threadType == 'hospital' &&
            request.resource.data.hospitalId is string &&
            request.resource.data.hospitalId in requestedMessageCase().data.get('assignedHospitalIds', [])
          )
        );

      allow create: if isCareAtlasStaff()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == currentUser().data.role
        && request.resource.data.patientId == requestedMessageCase().data.patientId
        && request.resource.data.threadType == 'careatlas'
        && request.resource.data.hospitalId == null
        && messagingConsentGranted(request.resource.data.caseId)
        && validMessageBody()
        && request.resource.data.source == 'admin_web'
        && request.resource.data.createdAt == request.time;

      allow create: if isHospitalUser()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == currentUser().data.role
        && request.resource.data.hospitalId == hospitalId()
        && request.resource.data.patientId == requestedMessageCase().data.patientId
        && request.resource.data.threadType == 'hospital'
        && hospitalCanAccessCase(requestedMessageCase().data)
        && messagingConsentGranted(request.resource.data.caseId)
        && validMessageBody()
        && request.resource.data.source == 'hospital_web'
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff() ||
        (
          isHospitalUser() &&
          resource.data.hospitalId == hospitalId() &&
          hospitalCanAccessCase(linkedMessageCase().data)
        )
      );

      allow update, delete: if false;
    }

    match /experienceReviews/{reviewId} {
      function requestedReviewCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      function linkedReviewCase() {
        return get(/databases/$(database)/documents/cases/$(resource.data.caseId));
      }

      function requestedReviewBooking() {
        return get(/databases/$(database)/documents/hotelBookings/$(request.resource.data.bookingId));
      }

      function validVerifiedJourney() {
        return request.resource.data.verifiedJourney == true
          && (
            (
              request.resource.data.targetType == 'hospital'
              && request.resource.data.targetId in requestedReviewCase().data.get('assignedHospitalIds', [])
              && requestedReviewCase().data.currentStage in ['treatment', 'follow_up']
            ) ||
            (
              request.resource.data.targetType == 'hotel'
              && request.resource.data.bookingId is string
              && request.resource.data.bookingId.size() > 0
              && requestedReviewBooking().data.patientId == request.auth.uid
              && requestedReviewBooking().data.caseId == request.resource.data.caseId
              && requestedReviewBooking().data.hotelId == request.resource.data.targetId
              && requestedReviewBooking().data.status == 'completed'
            ) ||
            (
              request.resource.data.targetType == 'careatlas'
              && request.resource.data.targetId == 'careatlas'
              && requestedReviewCase().data.currentStage in ['treatment', 'follow_up']
            )
          );
      }

      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.resource.data.reviewId == reviewId
        && request.resource.data.patientId == request.auth.uid
        && requestedReviewCase().data.patientId == request.auth.uid
        && request.resource.data.targetType in ['hospital', 'hotel', 'careatlas']
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.patientReportedOutcome in [
          'much_better', 'better', 'same', 'worse', 'prefer_not_to_say'
        ]
        && request.resource.data.wouldRecommend is bool
        && request.resource.data.status == 'pending_review'
        && request.resource.data.source == 'patient_web'
        && validVerifiedJourney()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff()
      );

      allow update: if signedIn()
        && resource.data.patientId == request.auth.uid
        && resource.data.status == 'pending_review'
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.caseId == resource.data.caseId
        && request.resource.data.targetType == resource.data.targetType
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.reviewId == resource.data.reviewId
        && request.resource.data.verifiedJourney == true
        && request.resource.data.status == 'pending_review'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'title', 'body', 'patientReportedOutcome', 'wouldRecommend', 'updatedAt'
        ])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.patientReportedOutcome in [
          'much_better', 'better', 'same', 'worse', 'prefer_not_to_say'
        ]
        && request.resource.data.wouldRecommend is bool
        && request.resource.data.updatedAt == request.time;

      allow update: if isCareAtlasStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'moderatedBy', 'moderatedAt', 'publishedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['pending_review', 'published', 'rejected', 'hidden']
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderatedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /publishedExperienceReviews/{reviewId} {
      allow read: if signedIn() && (
        isCareAtlasStaff() ||
        (
          isHospitalUser()
          && resource.data.status == 'published'
          && resource.data.targetType == 'hospital'
          && resource.data.targetId == hospitalId()
        ) ||
        (
          isHotelPartner()
          && resource.data.status == 'published'
          && resource.data.targetType == 'hotel'
          && resource.data.targetId == request.auth.uid
        )
      );

      allow create, update, delete: if isCareAtlasStaff();
    }

    match /reviewResponses/{reviewId} {
      function responseReview() {
        return get(/databases/$(database)/documents/publishedExperienceReviews/$(reviewId));
      }

      function providerCanRespond() {
        return responseReview().data.status == 'published'
          && (
            (
              isHospitalUser()
              && responseReview().data.targetType == 'hospital'
              && responseReview().data.targetId == hospitalId()
              && request.resource.data.providerType == 'hospital'
              && request.resource.data.providerId == hospitalId()
              && request.resource.data.source == 'hospital_web'
            ) ||
            (
              hotelPartnerApproved()
              && responseReview().data.targetType == 'hotel'
              && responseReview().data.targetId == request.auth.uid
              && request.resource.data.providerType == 'hotel'
              && request.resource.data.providerId == request.auth.uid
              && request.resource.data.source == 'hotel_web'
            )
          );
      }

      allow create: if signedIn()
        && request.resource.data.reviewId == reviewId
        && request.resource.data.respondedBy == request.auth.uid
        && providerCanRespond()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && resource.data.respondedBy == request.auth.uid
        && request.resource.data.reviewId == resource.data.reviewId
        && request.resource.data.providerType == resource.data.providerType
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.respondedBy == resource.data.respondedBy
        && providerCanRespond()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'providerName', 'responseText', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow read: if isCareAtlasStaff()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/experienceReviews/$(reviewId))
          && get(/databases/$(database)/documents/experienceReviews/$(reviewId)).data.patientId == request.auth.uid
        )
        || (
          isHospitalUser()
          && responseReview().data.status == 'published'
          && responseReview().data.targetType == 'hospital'
          && responseReview().data.targetId == hospitalId()
        )
        || (
          isHotelPartner()
          && responseReview().data.status == 'published'
          && responseReview().data.targetType == 'hotel'
          && responseReview().data.targetId == request.auth.uid
        );

      allow delete: if false;
    }

    match /patientConcerns/{concernId} {
      function requestedConcernCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      function requestedConcernBooking() {
        return get(/databases/$(database)/documents/hotelBookings/$(request.resource.data.bookingId));
      }

      function validConcernTarget() {
        return (
          request.resource.data.targetType == 'careatlas'
          && request.resource.data.targetId == 'careatlas'
        ) || (
          request.resource.data.targetType == 'hospital'
          && request.resource.data.targetId in requestedConcernCase().data.get('assignedHospitalIds', [])
        ) || (
          request.resource.data.targetType == 'hotel'
          && request.resource.data.bookingId is string
          && request.resource.data.bookingId.size() > 0
          && requestedConcernBooking().data.patientId == request.auth.uid
          && requestedConcernBooking().data.caseId == request.resource.data.caseId
          && requestedConcernBooking().data.hotelId == request.resource.data.targetId
        );
      }

      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.resource.data.concernId == concernId
        && request.resource.data.patientId == request.auth.uid
        && requestedConcernCase().data.patientId == request.auth.uid
        && request.resource.data.targetType in ['careatlas', 'hospital', 'hotel']
        && validConcernTarget()
        && request.resource.data.status == 'open'
        && request.resource.data.category in [
          'Communication', 'Hospital experience', 'Accommodation', 'Travel support',
          'Billing or charges', 'Privacy or consent', 'Other'
        ]
        && request.resource.data.source == 'patient_web'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff()
      );

      allow update: if isCareAtlasStaff()
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.caseId == resource.data.caseId
        && request.resource.data.concernId == resource.data.concernId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedTo', 'resolutionSummary', 'resolvedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['open', 'in_review', 'waiting_on_patient', 'resolved', 'closed']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /notifications/{notificationId} {
      function requestedNotificationCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      allow create: if isCareAtlasStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.recipientId == requestedNotificationCase().data.patientId
        && request.resource.data.patientId == requestedNotificationCase().data.patientId
        && request.resource.data.source == 'admin_web'
        && request.resource.data.readAt == null
        && request.resource.data.createdAt == request.time;

      allow create: if isHospitalUser()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByRole == currentUser().data.role
        && request.resource.data.hospitalId == hospitalId()
        && request.resource.data.recipientId == requestedNotificationCase().data.patientId
        && request.resource.data.patientId == requestedNotificationCase().data.patientId
        && hospitalCanAccessCase(requestedNotificationCase().data)
        && request.resource.data.source == 'hospital_web'
        && request.resource.data.readAt == null
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn() && (
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );

      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;

      allow delete: if false;
    }


    // Phase 8E — internal workflow tasks and browser-run SLA automation.
    match /workflowTasks/{taskId} {
      allow read: if isCareAtlasStaff();

      allow create: if isCareAtlasStaff()
        && request.resource.data.source in ['automation', 'manual']
        && request.resource.data.status in ['open', 'in_progress', 'blocked', 'completed', 'dismissed']
        && request.resource.data.priority in ['urgent', 'high', 'normal', 'low']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isCareAtlasStaff()
        && request.resource.data.source == resource.data.source
        && request.resource.data.caseId == resource.data.caseId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ['open', 'in_progress', 'blocked', 'completed', 'dismissed']
        && request.resource.data.priority in ['urgent', 'high', 'normal', 'low'];

      allow delete: if false;
    }

    match /workflowAutomationConfig/{configId} {
      allow read: if isCareAtlasStaff();
      allow create, update: if isAdmin()
        && configId == 'default'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /workflowAutomationRuns/{runId} {
      allow read: if isCareAtlasStaff();
      allow create: if isCareAtlasStaff()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == currentUser().data.role
        && request.resource.data.mode == 'browser_sync'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();

      allow create: if isCareAtlasStaff()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == currentUser().data.role
        && request.resource.data.action is string
        && request.resource.data.source == 'admin_web'
        && request.resource.data.createdAt == request.time;

      allow create: if isHospitalUser()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == currentUser().data.role
        && request.resource.data.hospitalId == hospitalId()
        && request.resource.data.action is string
        && request.resource.data.source == 'hospital_web'
        && request.resource.data.createdAt == request.time;


      allow create: if isHotelPartner()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == 'hotel_partner'
        && request.resource.data.hotelId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.source == 'hotel_web'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
