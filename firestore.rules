rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isCareAtlasStaff() {
      return hasUserProfile() && currentUser().data.role in [
        'careatlas_coordinator',
        'careatlas_operations',
        'careatlas_admin',
        'super_admin'
      ];
    }

    function isAdmin() {
      return hasUserProfile() && currentUser().data.role in [
        'careatlas_admin',
        'super_admin'
      ];
    }

    function isHospitalUser() {
      return hasUserProfile() && currentUser().data.role in [
        'hospital_admin',
        'hospital_doctor',
        'hospital_coordinator'
      ];
    }

    function hospitalId() {
      return currentUser().data.hospitalId;
    }

    function ownsCase(caseData) {
      return signedIn() && caseData.patientId == request.auth.uid;
    }

    function hospitalCanAccessCase(caseData) {
      return isHospitalUser() && hospitalId() in caseData.get('assignedHospitalIds', []);
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'patient';

      allow read: if signedIn() && (request.auth.uid == userId || isCareAtlasStaff());

      allow update: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId','email','role','hospitalId','status','createdAt'
        ]);

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow create: if signedIn()
        && request.auth.uid == patientId
        && request.resource.data.userId == request.auth.uid;

      allow read: if signedIn() && (request.auth.uid == patientId || isCareAtlasStaff());

      allow update: if signedIn()
        && request.auth.uid == patientId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId','email','createdAt']);

      allow update: if isCareAtlasStaff();
      allow delete: if false;
    }

    match /cases/{caseId} {
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.currentStage == 'case_submitted'
        && request.resource.data.assignedHospitalIds.size() == 0
        && request.resource.data.coordinatorId == null;

      allow read: if signedIn() && (
        ownsCase(resource.data) ||
        isCareAtlasStaff() ||
        hospitalCanAccessCase(resource.data)
      );

      allow update: if signedIn()
        && ownsCase(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'patientId','caseNumber','assignedHospitalIds','coordinatorId','coordinatorName',
          'status','currentStage','createdAt','submittedAt'
        ]);

      allow update: if isCareAtlasStaff();
      allow delete: if isAdmin();
    }

    match /caseDocuments/{documentId} {
      function linkedCase() {
        return get(/databases/$(database)/documents/cases/$(resource.data.caseId));
      }

      function requestedCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.storageProvider == 'google_drive'
        && requestedCase().data.patientId == request.auth.uid;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff() ||
        hospitalCanAccessCase(linkedCase().data)
      );

      allow update: if false;
      allow delete: if signedIn() && (resource.data.patientId == request.auth.uid || isAdmin());
    }

    match /hospitals/{hospitalDocId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /treatments/{treatmentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /destinations/{destinationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /treatmentPlans/{planId} {
      allow read: if signedIn() && (
        isCareAtlasStaff() ||
        resource.data.patientId == request.auth.uid ||
        (isHospitalUser() && resource.data.hospitalId == hospitalId())
      );

      allow create: if signedIn() && (
        isCareAtlasStaff() ||
        (isHospitalUser() && request.resource.data.hospitalId == hospitalId())
      );

      allow update: if signedIn() && (
        isCareAtlasStaff() ||
        (isHospitalUser() && resource.data.hospitalId == hospitalId())
      );

      allow delete: if isAdmin();
    }

    match /consultations/{consultationId} {
      allow read: if signedIn() && (
        isCareAtlasStaff() ||
        resource.data.patientId == request.auth.uid ||
        (isHospitalUser() && resource.data.hospitalId == hospitalId())
      );

      allow create: if signedIn();

      allow update: if signedIn() && (
        isCareAtlasStaff() ||
        resource.data.patientId == request.auth.uid ||
        (isHospitalUser() && resource.data.hospitalId == hospitalId())
      );

      allow delete: if isAdmin();
    }

    match /consents/{consentId} {
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid;
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid || isCareAtlasStaff());
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isCareAtlasStaff()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.source == 'admin_web';
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
