rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isCareAtlasStaff() {
      return hasUserProfile() && currentUser().data.role in [
        'careatlas_coordinator',
        'careatlas_operations',
        'careatlas_admin',
        'super_admin'
      ];
    }

    function isAdmin() {
      return hasUserProfile() && currentUser().data.role in [
        'careatlas_admin',
        'super_admin'
      ];
    }

    function hasReferralPartnerProfile() {
      return hasUserProfile()
        && currentUser().data.role in ['partner', 'patient']
        && currentUser().data.status != 'disabled'
        && exists(/databases/$(database)/documents/partners/$(request.auth.uid))
        && !(get(/databases/$(database)/documents/partners/$(request.auth.uid)).data.status in ['rejected', 'suspended']);
    }

    function isReferralPartner() {
      return hasReferralPartnerProfile()
        && get(/databases/$(database)/documents/partners/$(request.auth.uid)).data.status == 'approved';
    }

    function partnerKycVerified(partnerId) {
      return exists(/databases/$(database)/documents/partnerKyc/$(partnerId))
        && get(/databases/$(database)/documents/partnerKyc/$(partnerId)).data.status == 'verified';
    }

    function partnerPayoutVerified(partnerId) {
      return exists(/databases/$(database)/documents/partnerPayoutProfiles/$(partnerId))
        && get(/databases/$(database)/documents/partnerPayoutProfiles/$(partnerId)).data.status == 'verified';
    }

    function isHospitalUser() {
      return hasUserProfile() && currentUser().data.role in [
        'hospital_admin',
        'hospital_doctor',
        'hospital_coordinator'
      ];
    }

    function isHospitalClinicalUser() {
      return hasUserProfile() && currentUser().data.role in [
        'hospital_admin',
        'hospital_doctor'
      ];
    }

    function hospitalId() {
      return currentUser().data.hospitalId;
    }

    function ownsCase(caseData) {
      return signedIn() && caseData.patientId == request.auth.uid;
    }

    function hospitalCanAccessCase(caseData) {
      return isHospitalUser()
        && hospitalId() in caseData.get('assignedHospitalIds', []);
    }

    function consentState(caseId) {
      return get(/databases/$(database)/documents/caseConsentStates/$(caseId));
    }

    function hasConsentState(caseId) {
      return exists(/databases/$(database)/documents/caseConsentStates/$(caseId));
    }

    function medicalDataConsentGranted(caseId) {
      return hasConsentState(caseId)
        && consentState(caseId).data.medicalDataProcessing == true;
    }

    function hospitalDocumentConsentGranted(caseId) {
      return hasConsentState(caseId)
        && consentState(caseId).data.medicalDataProcessing == true
        && consentState(caseId).data.hospitalSharing == true;
    }

    function messagingConsentGranted(caseId) {
      return hasConsentState(caseId)
        && consentState(caseId).data.careCoordinationMessaging == true;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.role in ['patient', 'partner'];

      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isCareAtlasStaff()
      );

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'country', 'updatedAt'
        ]);

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'patient'
        && request.auth.uid == patientId
        && request.resource.data.userId == request.auth.uid;

      allow read: if signedIn() && (
        request.auth.uid == patientId ||
        isCareAtlasStaff()
      );

      allow update: if signedIn()
        && request.auth.uid == patientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'country', 'age', 'gender', 'phone',
          'preferredLanguage', 'updatedAt'
        ]);

      allow update: if isCareAtlasStaff();
      allow delete: if false;
    }

    match /cases/{caseId} {
      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.currentStage == 'case_submitted'
        && request.resource.data.assignedHospitalIds.size() == 0
        && request.resource.data.coordinatorId == null
        && request.resource.data.documentCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.submittedAt == request.time;

      allow read: if signedIn() && (
        ownsCase(resource.data) ||
        isCareAtlasStaff() ||
        hospitalCanAccessCase(resource.data)
      );

      allow update: if signedIn()
        && ownsCase(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'documentCount', 'updatedAt'
        ])
        && request.resource.data.documentCount is int
        && request.resource.data.documentCount >= 0
        && request.resource.data.updatedAt == request.time;

      allow update: if isCareAtlasStaff();
      allow delete: if isAdmin();
    }

    match /caseConsentStates/{caseId} {
      function requestedCase() {
        return get(/databases/$(database)/documents/cases/$(caseId));
      }

      allow create: if signedIn()
        && request.resource.data.caseId == caseId
        && request.resource.data.patientId == request.auth.uid
        && requestedCase().data.patientId == request.auth.uid
        && request.resource.data.version == '2026-08-24-v1'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.medicalDataProcessing is bool
        && request.resource.data.hospitalSharing is bool
        && request.resource.data.careCoordinationMessaging is bool;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff() ||
        hospitalCanAccessCase(requestedCase().data)
      );

      allow update: if signedIn()
        && resource.data.patientId == request.auth.uid
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.caseId == resource.data.caseId
        && requestedCase().data.patientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'version', 'medicalDataProcessing', 'hospitalSharing',
          'careCoordinationMessaging', 'updatedAt'
        ])
        && request.resource.data.version == '2026-08-24-v1'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.medicalDataProcessing is bool
        && request.resource.data.hospitalSharing is bool
        && request.resource.data.careCoordinationMessaging is bool;

      allow delete: if false;
    }

    match /consents/{consentId} {
      function requestedConsentCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      function linkedConsentCase() {
        return get(/databases/$(database)/documents/cases/$(resource.data.caseId));
      }

      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && requestedConsentCase().data.patientId == request.auth.uid
        && request.resource.data.consentType in [
          'medical_data_processing',
          'hospital_sharing',
          'care_coordination_messaging'
        ]
        && request.resource.data.decision in ['accepted', 'declined', 'withdrawn']
        && request.resource.data.version == '2026-08-24-v1'
        && request.resource.data.consentText is string
        && request.resource.data.source == 'patient_web'
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff() ||
        hospitalCanAccessCase(linkedConsentCase().data)
      );

      allow update, delete: if false;
    }

    match /caseDocuments/{documentId} {
      function linkedCase() {
        return get(/databases/$(database)/documents/cases/$(resource.data.caseId));
      }

      function requestedCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.storageProvider == 'google_drive'
        && requestedCase().data.patientId == request.auth.uid
        && medicalDataConsentGranted(request.resource.data.caseId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        (isCareAtlasStaff() && medicalDataConsentGranted(resource.data.caseId)) ||
        (
          hospitalCanAccessCase(linkedCase().data) &&
          hospitalDocumentConsentGranted(resource.data.caseId)
        )
      );

      allow update: if false;
      allow delete: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isAdmin()
      );
    }


    match /partners/{partnerId} {
      allow create: if signedIn()
        && request.auth.uid == partnerId
        && (
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'partner' ||
          (
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'patient' &&
            exists(/databases/$(database)/documents/patients/$(request.auth.uid))
          )
        )
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.commissionModel == 'revenue_share'
        && request.resource.data.commissionRatePct == 0
        && request.resource.data.termsAccepted == true
        && request.resource.data.disclosureAccepted == true
        && request.resource.data.termsVersion == '2026-08-25-v1'
        && request.resource.data.referralCode is string
        && request.resource.data.referralCode.size() >= 8
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        request.auth.uid == partnerId ||
        isAdmin()
      );

      allow update: if signedIn()
        && request.auth.uid == partnerId
        && resource.data.status in ['pending_review', 'approved']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'country', 'phone', 'organization', 'partnerType', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if isAdmin();
    }

    match /partnerKyc/{partnerId} {
      allow create: if hasReferralPartnerProfile()
        && request.auth.uid == partnerId
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.entityType in ['individual', 'business']
        && request.resource.data.legalName is string
        && request.resource.data.legalName.size() > 0
        && request.resource.data.country is string
        && request.resource.data.taxIdType is string
        && request.resource.data.taxId is string
        && request.resource.data.taxId.size() >= 4
        && request.resource.data.status == 'submitted'
        && request.resource.data.kycVersion == '2026-08-25-v1'
        && request.resource.data.createdAt == request.time
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        request.auth.uid == partnerId ||
        isAdmin()
      );

      allow update: if hasReferralPartnerProfile()
        && request.auth.uid == partnerId
        && resource.data.status != 'verified'
        && request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.status == 'submitted'
        && request.resource.data.reviewNote == ''
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'entityType','legalName','country','taxIdType','taxId','taxIdMasked',
          'addressLine1','addressLine2','city','region','postalCode','status',
          'kycVersion','reviewNote','reviewedBy','reviewedAt','submittedAt','updatedAt'
        ]);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reviewNote','reviewedBy','reviewedAt','updatedAt'
        ])
        && request.resource.data.status in ['submitted','needs_correction','verified','rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /partnerPayoutProfiles/{partnerId} {
      allow create: if hasReferralPartnerProfile()
        && request.auth.uid == partnerId
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.method in ['bank','upi']
        && request.resource.data.accountHolder is string
        && request.resource.data.accountHolder.size() > 0
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        request.auth.uid == partnerId ||
        isAdmin()
      );

      allow update: if hasReferralPartnerProfile()
        && request.auth.uid == partnerId
        && resource.data.status != 'verified'
        && request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.status == 'submitted'
        && request.resource.data.reviewNote == ''
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'method','payoutCurrency','payoutCountry','accountHolder','bankName',
          'accountNumber','accountNumberMasked','routingCode','swiftCode','upiId',
          'status','reviewNote','reviewedBy','reviewedAt','submittedAt','updatedAt'
        ]);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reviewNote','reviewedBy','reviewedAt','updatedAt'
        ])
        && request.resource.data.status in ['submitted','needs_correction','verified','rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /systemSettings/{settingId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /partnerPayoutRequests/{partnerId} {
      allow create: if isReferralPartner()
        && request.auth.uid == partnerId
        && request.resource.data.requestId == partnerId
        && request.resource.data.partnerId == partnerId
        && partnerKycVerified(partnerId)
        && partnerPayoutVerified(partnerId)
        && request.resource.data.status == 'requested'
        && request.resource.data.grossAmountSnapshot is number
        && request.resource.data.grossAmountSnapshot > 0
        && request.resource.data.taxWithheldSnapshot == 0
        && request.resource.data.netAmountSnapshot == request.resource.data.grossAmountSnapshot
        && request.resource.data.commissionIds is list
        && request.resource.data.commissionIds.size() > 0
        && request.resource.data.requestedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        request.auth.uid == partnerId ||
        isAdmin()
      );

      allow update: if isReferralPartner()
        && request.auth.uid == partnerId
        && resource.data.status in ['paid','rejected']
        && request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.requestId == resource.data.requestId
        && partnerKycVerified(partnerId)
        && partnerPayoutVerified(partnerId)
        && request.resource.data.status == 'requested'
        && request.resource.data.taxWithheldSnapshot == 0
        && request.resource.data.netAmountSnapshot == request.resource.data.grossAmountSnapshot
        && request.resource.data.commissionIds is list
        && request.resource.data.commissionIds.size() > 0
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'partnerName','grossAmountSnapshot','taxWithheldSnapshot','netAmountSnapshot',
          'currency','commissionIds','commissionCount','payoutMethod',
          'payoutDestinationSnapshot','status','paymentReference','settlementNote',
          'requestedAt','updatedAt','paidAt'
        ]);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','taxWithheldSnapshot','netAmountSnapshot','paymentReference',
          'settlementNote','paidAt','updatedAt'
        ])
        && request.resource.data.status in ['on_hold','paid','rejected']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /payoutSettlements/{settlementId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (hasReferralPartnerProfile() && resource.data.partnerId == request.auth.uid)
      );

      allow create: if isAdmin()
        && request.resource.data.settlementId == settlementId
        && request.resource.data.paidBy == request.auth.uid
        && request.resource.data.partnerId is string
        && request.resource.data.grossAmount is number
        && request.resource.data.taxWithheld is number
        && request.resource.data.netAmount is number
        && request.resource.data.netAmount >= 0
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() > 0
        && request.resource.data.paidAt == request.time
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /referralCodes/{code} {
      // Public callers may validate a code by exact document ID, but cannot enumerate codes.
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /partnerLeads/{leadId} {
      allow create: if isReferralPartner()
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 80
        && request.resource.data.treatmentInterest is string
        && request.resource.data.treatmentInterest.size() <= 120
        && request.resource.data.contactMethod in ['phone', 'whatsapp', 'email']
        && request.resource.data.contactValue is string
        && request.resource.data.contactValue.size() > 0
        && request.resource.data.contactValue.size() <= 160
        && request.resource.data.contactConsent == true
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.campaign is string
        && request.resource.data.campaign.size() <= 48
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'partner_web'
        && request.resource.data.convertedCaseId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        isCareAtlasStaff() ||
        (hasReferralPartnerProfile() && resource.data.partnerId == request.auth.uid)
      );

      allow update: if isCareAtlasStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'convertedCaseId', 'updatedAt'
        ])
        && request.resource.data.status in ['new', 'contacted', 'qualified', 'converted', 'closed']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }


    match /referrals/{referralId} {
      function requestedReferralCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      function requestedReferralCode() {
        return get(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCode));
      }

      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.resource.data.referralId == referralId
        && request.resource.data.caseId == referralId
        && requestedReferralCase().data.patientId == request.auth.uid
        && requestedReferralCode().data.status == 'active'
        && request.resource.data.partnerId == requestedReferralCode().data.partnerId
        && request.resource.data.caseNumber == requestedReferralCase().data.caseNumber
        && request.resource.data.patientCountry == requestedReferralCase().data.patientCountry
        && request.resource.data.treatmentName == requestedReferralCase().data.treatmentName
        && request.resource.data.currentStage == requestedReferralCase().data.currentStage
        && request.resource.data.caseStatus == requestedReferralCase().data.status
        && request.resource.data.referralStatus == 'case_created'
        && request.resource.data.commissionStatus == 'not_created'
        && request.resource.data.attributionModel == 'first_valid_referrer'
        && request.resource.data.attributionWindowDays == 60
        && request.resource.data.campaign is string
        && request.resource.data.campaign.size() <= 48
        && request.resource.data.selfReferral is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (
        isCareAtlasStaff() ||
        (hasReferralPartnerProfile() && resource.data.partnerId == request.auth.uid)
      );

      allow update: if isCareAtlasStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentStage', 'caseStatus', 'referralStatus', 'lockedAt', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'commissionStatus', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      // Attribution ownership is immutable in 7A. Any future override should use a dedicated audited server workflow.
      allow delete: if false;
    }

    match /commissions/{commissionId} {
      function requestedCommissionReferral() {
        return get(/databases/$(database)/documents/referrals/$(request.resource.data.referralId));
      }

      allow read: if signedIn() && (
        isAdmin() ||
        (hasReferralPartnerProfile() && resource.data.partnerId == request.auth.uid)
      );

      allow create: if isAdmin()
        && request.resource.data.commissionId == commissionId
        && request.resource.data.referralId == commissionId
        && request.resource.data.partnerId == requestedCommissionReferral().data.partnerId
        && requestedCommissionReferral().data.referralStatus == 'treatment_verified'
        && requestedCommissionReferral().data.get('selfReferral', false) == false
        && request.resource.data.status == 'pending'
        && request.resource.data.commissionModel == 'revenue_share'
        && request.resource.data.ratePct is number
        && request.resource.data.ratePct >= 0
        && request.resource.data.ratePct <= 100
        && request.resource.data.careAtlasRevenue is number
        && request.resource.data.careAtlasRevenue >= 0
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'approvedAt', 'paidAt', 'payoutRequestId', 'paymentReference'
        ])
        && request.resource.data.status in ['approved', 'on_hold', 'paid', 'rejected']
        && (request.resource.data.status != 'approved' || partnerKycVerified(resource.data.partnerId))
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /hospitals/{hospitalDocId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /treatments/{treatmentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /destinations/{destinationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /treatmentPlans/{planId} {
      function requestedPlanCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      allow read: if signedIn() && (
        isCareAtlasStaff() ||
        resource.data.patientId == request.auth.uid ||
        (isHospitalUser() && resource.data.hospitalId == hospitalId())
      );

      allow create: if isHospitalClinicalUser()
        && request.resource.data.hospitalId == hospitalId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.patientId == requestedPlanCase().data.patientId
        && hospitalCanAccessCase(requestedPlanCase().data)
        && request.resource.data.status == 'submitted'
        && request.resource.data.source == 'hospital_web';

      allow create: if isCareAtlasStaff();

      allow update: if isCareAtlasStaff() || (
        isHospitalClinicalUser()
        && resource.data.hospitalId == hospitalId()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'caseId','caseNumber','patientId','hospitalId','createdBy','createdAt','source'
        ])
      );

      allow delete: if isAdmin();
    }

    match /consultations/{consultationId} {
      function requestedConsultationCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      allow read: if signedIn() && (
        isCareAtlasStaff() ||
        resource.data.patientId == request.auth.uid ||
        (isHospitalUser() && resource.data.hospitalId == hospitalId())
      );

      allow create: if isHospitalUser()
        && request.resource.data.hospitalId == hospitalId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.patientId == requestedConsultationCase().data.patientId
        && hospitalCanAccessCase(requestedConsultationCase().data)
        && request.resource.data.status == 'proposed'
        && request.resource.data.source == 'hospital_web';

      allow create: if isCareAtlasStaff();

      allow update: if isCareAtlasStaff() || (
        isHospitalUser()
        && resource.data.hospitalId == hospitalId()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'caseId','caseNumber','patientId','hospitalId','createdBy','createdAt','source'
        ])
      );

      allow delete: if isAdmin();
    }

    match /caseMessages/{messageId} {
      function requestedMessageCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      function linkedMessageCase() {
        return get(/databases/$(database)/documents/cases/$(resource.data.caseId));
      }

      function validMessageBody() {
        return request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000;
      }

      allow create: if signedIn()
        && currentUser().data.role == 'patient'
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == 'patient'
        && request.resource.data.patientId == request.auth.uid
        && requestedMessageCase().data.patientId == request.auth.uid
        && messagingConsentGranted(request.resource.data.caseId)
        && validMessageBody()
        && request.resource.data.source == 'patient_web'
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.threadType == 'careatlas' &&
            request.resource.data.hospitalId == null
          ) ||
          (
            request.resource.data.threadType == 'hospital' &&
            request.resource.data.hospitalId is string &&
            request.resource.data.hospitalId in requestedMessageCase().data.get('assignedHospitalIds', [])
          )
        );

      allow create: if isCareAtlasStaff()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == currentUser().data.role
        && request.resource.data.patientId == requestedMessageCase().data.patientId
        && request.resource.data.threadType == 'careatlas'
        && request.resource.data.hospitalId == null
        && messagingConsentGranted(request.resource.data.caseId)
        && validMessageBody()
        && request.resource.data.source == 'admin_web'
        && request.resource.data.createdAt == request.time;

      allow create: if isHospitalUser()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == currentUser().data.role
        && request.resource.data.hospitalId == hospitalId()
        && request.resource.data.patientId == requestedMessageCase().data.patientId
        && request.resource.data.threadType == 'hospital'
        && hospitalCanAccessCase(requestedMessageCase().data)
        && messagingConsentGranted(request.resource.data.caseId)
        && validMessageBody()
        && request.resource.data.source == 'hospital_web'
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isCareAtlasStaff() ||
        (
          isHospitalUser() &&
          resource.data.hospitalId == hospitalId() &&
          hospitalCanAccessCase(linkedMessageCase().data)
        )
      );

      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      function requestedNotificationCase() {
        return get(/databases/$(database)/documents/cases/$(request.resource.data.caseId));
      }

      allow create: if isCareAtlasStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.recipientId == requestedNotificationCase().data.patientId
        && request.resource.data.patientId == requestedNotificationCase().data.patientId
        && request.resource.data.source == 'admin_web'
        && request.resource.data.readAt == null
        && request.resource.data.createdAt == request.time;

      allow create: if isHospitalUser()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByRole == currentUser().data.role
        && request.resource.data.hospitalId == hospitalId()
        && request.resource.data.recipientId == requestedNotificationCase().data.patientId
        && request.resource.data.patientId == requestedNotificationCase().data.patientId
        && hospitalCanAccessCase(requestedNotificationCase().data)
        && request.resource.data.source == 'hospital_web'
        && request.resource.data.readAt == null
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn() && (
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );

      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;

      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();

      allow create: if isCareAtlasStaff()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == currentUser().data.role
        && request.resource.data.action is string
        && request.resource.data.source == 'admin_web'
        && request.resource.data.createdAt == request.time;

      allow create: if isHospitalUser()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == currentUser().data.role
        && request.resource.data.hospitalId == hospitalId()
        && request.resource.data.action is string
        && request.resource.data.source == 'hospital_web'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
